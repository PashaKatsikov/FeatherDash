<?xml version="1.0" encoding="utf-8"?>
<!-- Launch background is the very first frame the Android system paints
     while the Flutter engine boots. Match it to the BootGate scaffold
     so the user doesn't see a white-to-navy flash on cold start. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_bg" />
</layer-list>

